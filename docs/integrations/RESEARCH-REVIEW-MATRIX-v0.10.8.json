{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DvirOS Neo-only six-filter review triage matrix v0.10.8",
  "description": "Private offline HMAC-authenticated operational review routing. No decisions or license.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "matrix",
    "matrix_sha256",
    "matrix_hmac_sha256"
  ],
  "properties": {
    "matrix_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "matrix_hmac_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "matrix": {
      "type": "object",
      "required": [
        "schema_version",
        "contract_kind",
        "source_work_id",
        "target_work_id",
        "parent_queue_sha256",
        "source_packet_sha256s",
        "page_limit",
        "required_filters",
        "filter_summaries",
        "candidate_count",
        "overlapping_specific_filter_candidate_count",
        "no_specific_filter_candidate_count",
        "rows",
        "all_six_complete_views_verified",
        "human_review_decisions_recorded",
        "licensed_source_rights_verified",
        "immutable_graph_snapshot_verified",
        "research_release_status"
      ],
      "properties": {
        "schema_version": {
          "const": "0.10.8"
        },
        "contract_kind": {
          "const": "dviros.research.signed_cross_filter_triage"
        },
        "source_work_id": {
          "type": "string"
        },
        "target_work_id": {
          "type": "string"
        },
        "parent_queue_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "source_packet_sha256s": {
          "type": "array",
          "minItems": 2,
          "maxItems": 6,
          "items": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "page_limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },
        "required_filters": {
          "const": [
            "all",
            "source_or_review",
            "membership",
            "selection",
            "other_metadata",
            "returned_state"
          ]
        },
        "filter_summaries": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "prefixItems": [
            {
              "type": "object",
              "required": [
                "reason_filter",
                "coverage_sha256",
                "page_count",
                "candidate_count",
                "candidate_ids_sha256"
              ],
              "properties": {
                "reason_filter": {
                  "const": "all"
                },
                "coverage_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "page_count": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 600
                },
                "candidate_count": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 600
                },
                "candidate_ids_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              }
            },
            {
              "type": "object",
              "required": [
                "reason_filter",
                "coverage_sha256",
                "page_count",
                "candidate_count",
                "candidate_ids_sha256"
              ],
              "properties": {
                "reason_filter": {
                  "const": "source_or_review"
                },
                "coverage_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "page_count": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 600
                },
                "candidate_count": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 600
                },
                "candidate_ids_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              }
            },
            {
              "type": "object",
              "required": [
                "reason_filter",
                "coverage_sha256",
                "page_count",
                "candidate_count",
                "candidate_ids_sha256"
              ],
              "properties": {
                "reason_filter": {
                  "const": "membership"
                },
                "coverage_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "page_count": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 600
                },
                "candidate_count": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 600
                },
                "candidate_ids_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              }
            },
            {
              "type": "object",
              "required": [
                "reason_filter",
                "coverage_sha256",
                "page_count",
                "candidate_count",
                "candidate_ids_sha256"
              ],
              "properties": {
                "reason_filter": {
                  "const": "selection"
                },
                "coverage_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "page_count": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 600
                },
                "candidate_count": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 600
                },
                "candidate_ids_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              }
            },
            {
              "type": "object",
              "required": [
                "reason_filter",
                "coverage_sha256",
                "page_count",
                "candidate_count",
                "candidate_ids_sha256"
              ],
              "properties": {
                "reason_filter": {
                  "const": "other_metadata"
                },
                "coverage_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "page_count": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 600
                },
                "candidate_count": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 600
                },
                "candidate_ids_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              }
            },
            {
              "type": "object",
              "required": [
                "reason_filter",
                "coverage_sha256",
                "page_count",
                "candidate_count",
                "candidate_ids_sha256"
              ],
              "properties": {
                "reason_filter": {
                  "const": "returned_state"
                },
                "coverage_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "page_count": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 600
                },
                "candidate_count": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 600
                },
                "candidate_ids_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              }
            }
          ]
        },
        "candidate_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 600
        },
        "overlapping_specific_filter_candidate_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 600
        },
        "no_specific_filter_candidate_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 600
        },
        "rows": {
          "type": "array",
          "maxItems": 600,
          "items": {
            "type": "object",
            "required": [
              "evidence_id",
              "reason_codes",
              "matched_filters",
              "matched_specific_filter_count",
              "selected_in_latest_capture",
              "observed_in_latest_window",
              "returned_to_prior_observed_state",
              "human_review_approved",
              "licensed_source_rights_verified"
            ],
            "properties": {
              "evidence_id": {
                "type": "string"
              },
              "reason_codes": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "matched_filters": {
                "type": "array",
                "minItems": 1,
                "maxItems": 6,
                "items": {
                  "enum": [
                    "all",
                    "source_or_review",
                    "membership",
                    "selection",
                    "other_metadata",
                    "returned_state"
                  ]
                },
                "uniqueItems": true
              },
              "matched_specific_filter_count": {
                "type": "integer",
                "minimum": 0,
                "maximum": 5
              },
              "selected_in_latest_capture": {
                "type": "boolean"
              },
              "observed_in_latest_window": {
                "type": "boolean"
              },
              "returned_to_prior_observed_state": {
                "type": "boolean"
              },
              "human_review_approved": {
                "const": false
              },
              "licensed_source_rights_verified": {
                "const": false
              }
            }
          }
        },
        "all_six_complete_views_verified": {
          "const": true
        },
        "dviros_workspace_authorization_verified": {
          "const": false
        },
        "human_review_decisions_recorded": {
          "const": false
        },
        "licensed_source_rights_verified": {
          "const": false
        },
        "immutable_graph_snapshot_verified": {
          "const": false
        },
        "research_release_status": {
          "const": "HOLD"
        }
      }
    }
  },
  "x-scope": "Authenticated six-filter metadata coverage, not a complete immutable corpus snapshot.",
  "x-nonclaims": [
    "no user authorization",
    "no saved reviewer decisions",
    "no rights grants",
    "no graph writes",
    "no live provider identity",
    "no independently trusted timestamp"
  ]
}
