    "queries": [
      "RETURN 1 AS result",
      "MATCH (n) RETURN count(n) AS result",
      "MATCH ()-[r]->() RETURN count(r) AS result",
      "MATCH (p:Passage) RETURN count(p) AS result",
      "MATCH (s:SourceRecord) RETURN count(s) AS result",
      "SHOW CONSTRAINTS YIELD name RETURN count(*) AS result"
