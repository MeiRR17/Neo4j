  "x-cli": {
    "plan": "python scripts/isolated_restore_drill_v0131.py plan --archive /private/neo4j.dump --manifest /private/manifest.json",
    "execute": "python scripts/isolated_restore_drill_v0131.py execute --archive /private/neo4j.dump --manifest /private/manifest.json --output /private/drill.restore-drill.json --ack-isolated-volume",
    "automatic_execution": false,
    "no_git_repo_or_live_compose_mount": true
  },
  "x-runtime": {
    "image": "neo4j/neo4j-admin:2026.10.1",
    "docker_pull": "never",
    "network": "none",
    "temporary_volume_label": "dviros.neo.restore-drill=v0.13.1",
    "fixed_commands": [
      "neo4j-admin database load neo4j --from-stdin",
      "neo4j-admin database check neo4j"
    ],
    "load_timeout_seconds": 7200,
    "consistency_timeout_seconds": 1800,
    "archive_stream_chunk_bytes": 1048576,
    "report_owner_only_mode": "0600",
    "report_reusable_as_production_release_approval": false
