# Optional local settings. Copy to .env only if you need overrides.
# Credentials are never stored in .env; see secrets/neo4j_auth.txt.
COMPOSE_PROJECT_NAME=dviros-philosophy
NEO4J_HEAP_INITIAL=512m
NEO4J_HEAP_MAX=1G
NEO4J_PAGE_CACHE=512m

# Research API v0.6 signing is mandatory in the local API runner.
# Keep credentials in owner-only local secret files, NEVER in .env.
# DVIROS_RESEARCH_API_TOKEN_FILE=/secure/neo4j/research_api_token.txt
# DVIROS_SIGNATURE_KEY_FILE=/secure/neo4j/dviros_hmac_key.txt
# DVIROS_REQUIRE_SIGNED_CALLS=1
